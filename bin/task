#!/bin/bash
# YYLO Ledger CLI compatibility wrapper
# This script provides a convenient way to run the task manager from anywhere

set -e  # Exit on error

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Check if virtual environment exists and activate it
VENV_PATH="$PROJECT_ROOT/.venv_yylo"
if [ ! -d "$VENV_PATH" ] && [ -d "$PROJECT_ROOT/.venv_juno" ]; then
    # Bounded migration fallback: virtualenvs are not safely relocatable.
    echo "task: .venv_juno is deprecated; recreate it as .venv_yylo" >&2
    VENV_PATH="$PROJECT_ROOT/.venv_juno"
fi
if [ -d "$VENV_PATH" ]; then
    source "$VENV_PATH/bin/activate"
fi

# Add src to Python path and execute the task manager
export PYTHONPATH="$PROJECT_ROOT/src:$PYTHONPATH"

# Suppress the RuntimeWarning about module imports to save LLM tokens
export PYTHONWARNINGS="ignore::RuntimeWarning"

# Execute the CLI module with all arguments
exec python3 -m yylo_ledger.cli "$@"
